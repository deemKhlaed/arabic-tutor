# Paste this into Streamlit Community Cloud → your app → Settings → Secrets, with your real values.
# Top-level keys become environment variables, which is how the app reads them.
# Never add SUPABASE_SECRET_KEY / the service_role key here.

CF_ACCOUNT_ID = ""
CF_AI_API_TOKEN = ""
CF_MODEL = "@cf/qwen/qwen3.8-27b"
CF_VISION_MODEL = "@cf/qwen/qwen3.8-27b"
CF_EMBED_MODEL = "@cf/baai/bge-m3"
CF_CHAT_REASONING = "off"

SUPABASE_URL = ""
SUPABASE_PUBLISHABLE_KEY = ""
SUPABASE_DB_URL = ""   # session pooler, port 5432

LANGSMITH_TRACING = "true"
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "arabic-tutor"
LANGSMITH_ENDPOINT = "https://eu.api.smith.langchain.com"
