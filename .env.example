CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_MODEL=@cf/qwen/qwen3.8-27b
CF_CHAT_REASONING=off                # off (fast, default) | low | medium
CF_VISION_MODEL=@cf/qwen/qwen3.8-27b   # or @cf/meta/llama-3.2-11b-vision-instruct
CF_EMBED_MODEL=@cf/baai/bge-m3
SUPABASE_URL=
SUPABASE_ANON_KEY=          # or SUPABASE_PUBLISHABLE_KEY; never the service_role / secret key
SUPABASE_DB_URL=            # Postgres connection string, for the LangGraph checkpointer (session pooler, port 5432)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arabic-tutor
# EU accounts (smith.langchain.com shows eu. in the URL) need: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
